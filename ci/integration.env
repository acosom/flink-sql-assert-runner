RUN_UNIT_TESTS=false
RESULT_FILE=./result.txt

VALUE_AVRO_SCHEMA={"type":"record","name":"Input","namespace":"test.example","fields":[{"name":"id","type":"string"},{"name":"uuid","type":["null","string"],"default":null},{"name":"name","type":"string"}]}
SOURCE_TOPIC=it_input_topic
SINK_TOPIC=it_output_topic
SCHEMA_REGISTRY=http://localhost:18081
JOB_NAME=flink-job
# Defaults below assume host-side use (running mvn / java -jar directly).
# The docker-compose service overrides these with in-network endpoints
# (redpanda:9092, http://redpanda:8081, etc.) — see docker-compose.yaml.
PROPERTIES_BOOTSTRAP_SERVERS=localhost:19092
VALUE_AVRO_CONFLUENT_URL=http://localhost:18081
PROPERTIES_SECURITY_PROTOCOL=PLAINTEXT
TOPIC_AUTO_CREATE_PARTITIONS=1
TOPIC_AUTO_CREATE_REPLICATION_FACTOR=1
PROPERTIES_SECURITY_MECHANISM=PLAIN

INTEGRATION_TEST_DATA_DIR=./src/main/resources/integration
INTEGRATION_KAFKA_SERVER=localhost:19092
INTEGRATION_SCHEMA_REGISTRY_URL=http://localhost:18081
INTEGRATION_FLINK_JOBMANAGER_SERVER=http://localhost:8081
INTEGRATION_TEST_SUCCESS_TIMEOUT_MS=5000
# Program args passed verbatim to the Flink job JAR's main(). Adjust to match
# whatever CLI convention your SQL runner uses — e.g. `--sqlfile /path/x.sql`
# for acosom/flink-sql-runner, or just `/path/x.sql` for a positional-arg JAR.
# The /opt/flink/sql/ prefix matches the mount path in ci/docker-compose.yaml.
INTEGRATION_FLINK_JOB_PROGRAM_ARGS=--sqlfile /opt/flink/sql/flink-job.sql
INTEGRATION_OUTPUT_TOPICS=it_output_topic
INTEGRATION_FLINK_JOB_ENTRYPOINT_CLASS=io.acosom.flink.sqlrunner.SqlRunnerMain
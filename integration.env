RUN_UNIT_TESTS=false
RESULT_FILE=./result.txt

VALUE_AVRO_SCHEMA={"type":"record","name":"Input","namespace":"test.example","fields":[{"name":"id","type":"string"},{"name":"uuid","type":["null","string"],"default":null},{"name":"name","type":"string"}]}
SOURCE_TOPIC=it_input_topic
SINK_TOPIC=it_output_topic
SCHEMA_REGISTRY=http://localhost:8080/apis/ccompat/v7
JOB_NAME=flink-job
PROPERTIES_BOOTSTRAP_SERVERS=kafka_broker:29092
